# Public site URL (used for Stripe redirect URLs and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social links shown in the Contact card. Buttons stay hidden until you fill these in.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# Supabase Project Credentials (from Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database (optional). Without it, bookings and inquiries are saved to .data/store.json (local dev only).
# For production use any Postgres (Supabase / Neon). Tables are created automatically.
DATABASE_URL=
DATABASE_SSL=true

# Stripe (optional). Without it, the booking widget sends the traveller to WhatsApp to confirm and pay.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email notifications to the owner via Resend (optional)
RESEND_API_KEY=
NOTIFY_FROM=Rising Stars Adventure <bookings@yourdomain.com>
NOTIFY_TO=therisingstarsadventure@gmail.com

# Protects /admin and /api/admin. Set a long random string.
ADMIN_TOKEN=
